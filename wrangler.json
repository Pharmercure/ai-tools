{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "ai-tools",
	"main": "./src/worker/index.ts",
	"compatibility_date": "2025-10-08",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"previews": {
		"d1_databases": [
			{
				"binding": "DB",
				"database_name": "ai-tools-db",
				"database_id": "356d7cab-f69d-4bbb-b369-da286ab2bb32"
			}
		],
		"observability": {
			"logs": {
				"enabled": true,
				"head_sampling_rate": 1,
				"invocation_logs": true,
				"persist": true
			},
			"traces": {
				"enabled": false,
				"head_sampling_rate": 1,
				"persist": true
			},
			"issue_detection": {
				"enabled": false
			}
		},
	},
	"triggers": {
		"crons": [
			"0 5 * * 1"
		]
	},
	"upload_source_maps": true,
	"assets": {
		"directory": "./dist/client",
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/api/*"
		]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "ai-tools-db",
			"database_id": "356d7cab-f69d-4bbb-b369-da286ab2bb32",
			"migrations_dir": "migrations"
		}
	],
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1,
		"redact_query_string": false,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"invocation_logs": true,
			"persist": true
		},
		"traces": {
			"enabled": true,
			"head_sampling_rate": 1,
			"persist": true
		},
		"issues": {
			"enabled": true
		}
	},
}