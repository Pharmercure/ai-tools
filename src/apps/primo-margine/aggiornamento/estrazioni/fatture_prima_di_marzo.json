{
 "collection": "Invoice",
 "file": "fatture_prima_di_marzo.json",
 "pipeline": [
  {
   "$match": {
    "InsertDate": {
     "$lt": {
      "$date": "2026-03-01T00:00:00Z"
     }
    },
    "To": {
     "$gte": {
      "$date": "2026-03-01T00:00:00Z"
     }
    }
   }
  },
  {
   "$project": {
    "_id": 0,
    "x": "$ExternalId",
    "p": "$Partner.PharmacyId",
    "g": "$Partner.GroupId",
    "gb": "$IsBillingGroup",
    "t": "$Type",
    "f": "$From",
    "to": "$To",
    "net": "$TotalToBePaidNet",
    "ins": "$InsertDate",
    "prod": "$FICInvoice.FICProducts"
   }
  },
  {
   "$group": {
    "_id": "fatturePrimaDiMarzo",
    "n": {
     "$sum": 1
    },
    "righe": {
     "$push": "$$ROOT"
    }
   }
  }
 ]
}